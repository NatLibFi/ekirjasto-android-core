# Add the upload keystore and key passwords here (required for production builds)
ekirjasto.storePassword=
ekirjasto.keyPassword=
ekirjasto.keyalias=key0

# Change "test" below with the liblcp AAR secret path
ekirjasto.liblcp.repositorylayout=/[organisation]/[module]/android/aar/test/[revision].[ext]

# Production liblcp (4.3.0+) refuses to load when the app is built with
# debuggable=true (anti-debug tamper detection; logs trustScore=-999 and
# aborts with "Strict mode: tamper detected"). Release builds are unaffected
# because they default to debuggable=false. If you need to exercise LCP
# functionality from a debug build (devDebug etc.), uncomment the line below.
# Trade-off: disables attached-debugger support (breakpoints, step-through).
#ekirjasto.debug.debuggable=false

# Set test login username and PIN code (base64 encoded) for Google Play review
ekirjasto.testLogin.enabled=true
ekirjasto.testLogin.username=
ekirjasto.testLogin.pin.base64=

# Add the base64 encoded Transifex token here
transifex.token.base64=
# Optionally, add the Transifex token here (only used by transifex.sh)
transifex.token=
# Optionally, add the Transifex secret here (only used by transifex.sh)
transifex.secret=
